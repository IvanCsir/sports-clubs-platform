{
  "name": "psb-regatas-andino",
  "version": "1.0.0",
  "description": "Plataforma multi-club de hockey",
  "private": true,
  "scripts": {
    "start": "npm run frontend:build && node server.js",
    "dev": "npm run frontend:dev",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "node scripts/migrate-db.js",
    "db:import-sheets": "node scripts/import-sheets-to-postgres.js",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "check": "node --check server.js && node --check api/club-data.js && node --check api/auth.js && node --check api/_lib/sports-data.js",
    "test:security": "node --test tests/security.test.js",
    "precarga": "node scripts/amh_precarga.js",
    "precarga:primera": "node scripts/amh_precarga.js --division=1",
    "precarga:intermedia": "node scripts/amh_precarga.js --division=2"
  },
  "keywords": [
    "hockey",
    "regatas-andino",
    "citaciones",
    "live-tracker",
    "pwa"
  ],
  "author": "Club Regatas Andino",
  "license": "ISC",
  "dependencies": {
    "@sparticuz/chromium-min": "^153.0.0",
    "pg": "^8.23.1",
    "puppeteer-core": "^25.15.0"
  }
}
